APP_NAME="Tiempo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Instants are always stored in UTC. The user timezone below only decides where
# local days and weeks begin; each user can override it in Ajustes.
APP_USER_TIMEZONE=America/Guatemala

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tiempo
DB_USERNAME=tiempo
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Host port the dev MySQL container is published on.
DB_FORWARD_PORT=3316

SESSION_DRIVER=database
# 28 days, so the phone does not log out between sessions.
SESSION_LIFETIME=40320
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="tiempo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The single account DatabaseSeeder provisions. Never commit a real password.
PERSONAL_USER_NAME=
PERSONAL_USER_EMAIL=
PERSONAL_USER_PASSWORD=

# Ports used by docker-compose.yml in development.
APP_PORT=8080
VITE_PORT=5173
