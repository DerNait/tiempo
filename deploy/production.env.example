# Template of /var/www/tiempo/shared/.env on the server.
# scripts/initialize-production.sh generates the real file with random secrets;
# this copy exists only so the expected keys are documented in the repository.
# Never commit real values.

APP_NAME="Tiempo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tiempo.dernait.com
APP_USER_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tiempo
DB_USERNAME=tiempo
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=40320
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=tiempo.dernait.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=tiempo.dernait.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=darkcsjuegos1@gmail.com
MAIL_FROM_NAME="Tiempo"

PERSONAL_USER_NAME=DerNait
PERSONAL_USER_EMAIL=darkcsjuegos1@gmail.com
PERSONAL_USER_PASSWORD=
